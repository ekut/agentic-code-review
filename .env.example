# OpenAI API Key for LLM calls
OPENAI_API_KEY=your_openai_api_key_here

# Serper API Key for web search functionality
SERPER_API_KEY=your_serper_api_key_here

# Optional: Serper base URL (defaults to https://google.serper.dev)
DLAI_SERPER_BASE_URL=https://google.serper.dev

# GitHub Personal Access Token for PR integration
# Required for fetching PR data from GitHub repositories
# Create a token at: https://github.com/settings/tokens
# Required scopes: repo (for private repos) or public_repo (for public repos only)
GITHUB_TOKEN=your_github_token_here

# ============================================================================
# LLM Model Configuration (Optional)
# ============================================================================
# Configure which OpenAI model each agent uses for code review.
# If not set, CrewAI will use its default model selection.
# 
# This allows you to optimize cost and performance by choosing different models
# for different agent roles based on their complexity and requirements.
#
# Common OpenAI model options:
#   - gpt-4o          : Most capable, best for complex analysis (higher cost)
#   - gpt-4o-mini     : Balanced performance and cost (recommended)
#   - gpt-4-turbo     : Fast and capable, good for most tasks
#   - gpt-3.5-turbo   : Fastest and most cost-effective (lower capability)
#
# Trade-offs:
#   - Cost: gpt-3.5-turbo < gpt-4o-mini < gpt-4-turbo < gpt-4o
#   - Capability: gpt-3.5-turbo < gpt-4o-mini < gpt-4-turbo < gpt-4o
#   - Speed: gpt-3.5-turbo > gpt-4-turbo > gpt-4o-mini > gpt-4o
# ============================================================================

# Model for Senior Developer agent (evaluates code quality and maintainability)
# SENIOR_DEVELOPER_MODEL=gpt-4o-mini

# Model for Security Engineer agent (identifies security vulnerabilities)
# SECURITY_ENGINEER_MODEL=gpt-4o-mini

# Model for Tech Lead agent (makes final approval decisions)
# TECH_LEAD_MODEL=gpt-4o-mini
